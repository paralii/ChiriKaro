{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    /* Language */
    "target": "ES2022",
    "lib": ["ES2022"],

    /* Module */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    /* Project */
    "rootDir": "./src",
    "outDir": "./dist",

    /* Path Aliases */
    "baseUrl": "./src",
    "paths": {
      "@config/*": ["config/*"],
      "@constants/*": ["constants/*"],
      "@controllers/*": ["controllers/*"],
      "@dto/*": ["dto/*"],
      "@entities/*": ["entities/*"],
      "@enums/*": ["enums/*"],
      "@errors/*": ["errors/*"],
      "@infrastructure/*": ["infrastructure/*"],
      "@interfaces/*": ["interfaces/*"],
      "@middleware/*": ["middleware/*"],
      "@repositories/*": ["repositories/*"],
      "@routes/*": ["routes/*"],
      "@services/*": ["services/*"],
      "@shared/*": ["shared/*"],
      "@use-cases/*": ["use-cases/*"],
      "@utils/*": ["utils/*"],
      "@validations/*": ["validations/*"]
    },

    /* Node */
    "types": ["node"],
    "resolveJsonModule": true,

    /* Type Checking */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    /* Interop */
    "esModuleInterop": true,

    /* Output */
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    /* Performance */
    "skipLibCheck": true,

    /* Consistency */
    "forceConsistentCasingInFileNames": true,

    /* Modern TS */
    "verbatimModuleSyntax": true,
    "isolatedModules": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}